+# beats.yaml — a launch-film starter (lv.mjs --init --kit film): product UI composited over AI footage, in the grammar
+# of the AI-footage launch films — a co-brand open, a title that zooms through the camera, UI pinned over footage,
+# light agent UI shot close, a card stack and a video wall, hard cuts on actions.
+# Film blocks: lockup · type · scene (overlays: bar · bubble · words · pill · orb) · agent · roster · stack · wall.
+# It runs as is: no footage needed yet. Then drop your AI clips into assets/ (generated in Higgsfield, Veo, Kling …) and
+# un-comment the `bg:` lines (and swap the placeholder cards for clips) — or keep the scenes bg-less and export their
+# UI as overlays to lay over your footage in CapCut (`--clips hook,command --alpha`).
+title: Your launch film
+slug: launch-film
+aspects: [16x9, 9x16, 1x1]       # each is re-laid out, not cropped
+thumbnail: name
+
+brand:
+  name: Product
+  mono: P
+  # logo: assets/logo.svg        # your mark (SVG/PNG): the lockup, the co-brand line, the prompt-bar tag
+  colors: {bg: "#F4F4F7", ink: "#111116", muted: "#80808C", accent: "#5747F2", accent2: "#FF7A45", accent3: "#FFB547", line: "#C9CBD6"}
+  bg: plain
+  # cast: [{shape: bean, col: "#4C6BFF"}, {shape: clover, col: "#FF7A45"}]   # the mascots (agents, lockup)
+
+music: {style: keynote}          # 124 BPM; or your track: {style: track, file: assets/song.mp3, start: 0}  (lv.mjs --tempo …)
+
+shots:
+  # 1 · co-brand card: logos + names type in, × pops, mascots bounce in; the zoom-in exit flies into the title
+  - id: open
+    block: lockup                # every block and its fields: GUIDE.md → "Blocks" (or lv.mjs --blocks)
+    beats: 5
+    partner: {name: Partner}     # {name, logo: assets/partner.svg}
+    pill: Your launch crew
+    cast: 6
+    out: zoom-in
+
+  # 2 · the name settles (tracking, blur, a glint) and zooms THROUGH the camera; hard cut after
+  - id: name
+    block: type
+    beats: 5
+    over: Product × Partner
+    text: Product 2
+    face: serif                  # sans | serif (system serif) | brand (brand.font)
+    pill: agents that *ship*
+    through: true
+    # bg: assets/your-ai-footage.mp4      # footage behind it (it pushes in with the zoom-through)
+    out: cut
+
+  # 3 · the brief arrives: a message bubble over the footage, then a status pill
+  - id: hook
+    block: scene
+    beats: 6
+    # bg: assets/your-ai-footage.mp4      # e.g. a hand holding a phone at dusk
+    # letterbox: true                     # 2.39:1 cinema bars
+    overlays:
+      - {at: 10, pos: left, bubble: "Launch is Friday. Help?", time: Today 9:41, from: Maya}
+      - {at: 44, pos: bottom-right, pill: Opening the brief…, mascot: 1}
+    out: cut
+
+  # 4 · kinetic words pop round the subject and clear (until), then the ask is typed into a dark composer and sent
