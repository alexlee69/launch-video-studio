+    block: scene
+    beats: 8
+    theme: dark                  # light-on-dark without footage too (a bg shot is dark unless theme: light)
+    # bg: assets/your-ai-footage.mp4
+    overlays:
+      - {at: 0, pos: [0.36, 0.36], words: [Who?, Which cut?, "By *when?*"], every: 9, until: 40}
+      - {at: 34, pos: bottom-right, bar: Cut our launch film by Friday., chip: Product 2}
+    out: cut
+
+  # 5 · the agents get to work: your message, rows that think and stream a reply, a message bar
+  - id: brief
+    block: agent
+    beats: 8
+    user: Cut our launch film by Friday.
+    rows:
+      - {avatar: spark, name: Product, status: Planning, done: Team briefed, reply: "Briefing the crew now."}
+      - {avatar: 0, name: Scout, status: Scouting, done: Done, reply: "Combing through films like yours."}
+    input: Message Product…
+    push: 0                 # the measured look: no zoom inside UI shots, they drift
+    out: drift-up           # a momentum cut: speeds up into the cut, the list enters still moving
+
+  # 6 · your agents: a close list behind a fixed highlight that never stops, one momentum step per beat
+  - id: team
+    block: roster
+    beats: 6
+    push: 0
+    drift: {in: 2}          # enter the list harder than the default
+    agents:
+      - {name: Scout, sub: Digs up what's working, mascot: 0}
+      - {name: Writer, sub: Writes it in your voice, mascot: 2}
+      - {name: Storyboard, sub: See it before it's shot, mascot: 1}
+      - {name: Motion, sub: Make it move, mascot: 3}
+    more: Meet the whole team
+    out: whip-up
+
+  # 7 · a deep 3D card stack cycles; the last card settles and a status pill lands on it
+  - id: scan
+    block: stack
+    beats: 7
+    cards: [assets/placeholder-clip-1.svg, assets/placeholder-clip-2.svg, assets/placeholder-clip-3.svg, assets/placeholder-clip-4.svg]   # images or clips
+    count: 8
+    pill: Studying 120 launch films
+    out: blur
+
+  # 8 · the next command in a macro prompt bar that tracks the caret (no bg: a transparent overlay clip with --alpha)
+  - id: command
+    block: scene
+    beats: 5
+    overlays:
+      - {at: 0, pos: center, bar: /teasers Cut three for Friday, theme: light, framing: macro, tag: Product, speed: 1.2}
+      - {at: 48, pos: [0.5, 0.7], pill: Cutting 3 teasers, mascot: spark}
+    out: zoom-out
+
+  # 9 · every cut on a floating wall of phone videos with label chips
+  - id: wall
+    block: wall
+    beats: 7
+    cards: [assets/placeholder-clip-1.svg, assets/placeholder-clip-2.svg, assets/placeholder-clip-3.svg, assets/placeholder-clip-4.svg]
+    chips: [Hook in 1s, Captions]
+    text: Every cut, *on brand.*
+    out: blur
+
+  # 10 · end line
+  - id: end
+    block: type
+    beats: 5
+    over: Product 2
+    text: Your launch team.|*On call.*
