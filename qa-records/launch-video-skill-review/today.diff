+.thumb img { display: block; width: 100%; height: auto; }
+.thumb .play { position: absolute; left: 8px; bottom: 8px; font: 500 11px/1 var(--mono); color: #fff; background: rgba(0, 0, 0, .62); padding: 5px 7px; border-radius: 5px; }
+.main { display: grid; gap: 8px; min-width: 0; align-content: start; }
+.tags { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
