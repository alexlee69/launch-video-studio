+<style>
+/* Edit-bay notes: a sticky monitor (film + shot strip) beside the shot log; on phones the monitor pins above the log. */
+:root {
+  --paper: #F3F4F7; --sheet: #FFFFFF; --ink: #16181D; --muted: #5D6371; --line: #DADDE4; --well: #ECEEF2;
