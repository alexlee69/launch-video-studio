+  --accent: __ACCENT_DARK__; --mark: #FF9A62; --mark-bg: #2E1B10; --ok: #63D894; --ok-bg: #11271A; --ask: #F2C14E; --ask-bg: #2A2310;
+  color-scheme: dark;
+}
+body { background: var(--paper); color: var(--ink); font: 15px/1.5 var(--body); }
+body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--paper); }
+* { box-sizing: border-box; }
+.wrap { max-width: 1440px; margin: 0 auto; padding-block: 28px 72px;
+  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
+.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
+.label { font: 500 11px/1.3 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
+em.acc { font-style: normal; color: var(--accent); }
+
+/* header */
+.top { display: grid; gap: 10px; margin-bottom: 26px; max-width: 76ch; }
+h1 { margin: 0; font: 760 clamp(28px, 4.4vw, 46px)/1.04 var(--display); font-stretch: 82%; letter-spacing: -.01em; text-wrap: balance; }
+.meta { margin: 0; color: var(--muted); font-size: 13px; }
+.how { margin: 4px 0 0; color: var(--ink); max-width: 64ch; }
+.tally { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 6px; }
+.pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; font: 500 12px/1.4 var(--mono); border: 1px solid var(--line); color: var(--muted); background: var(--sheet); white-space: nowrap; }
+.pill.open { color: var(--mark); background: var(--mark-bg); border-color: transparent; }
+.pill.keep { color: var(--ink); }
+.pill.done { color: var(--ok); background: var(--ok-bg); border-color: transparent; }
+.pill.question { color: var(--ask); background: var(--ask-bg); border-color: transparent; }
+.pill[hidden] { display: none; }
+button { font: inherit; color: inherit; }
+.btn { border: 1px solid var(--ink); background: var(--ink); color: var(--paper); border-radius: 8px; padding: 6px 12px; font: 500 13px/1.3 var(--body); cursor: pointer; }
+.btn.ghost { background: transparent; color: var(--ink); border-color: var(--line); }
+.btn:hover { filter: brightness(1.12); }
