+.seg.question::after { background: var(--ask); }
+.seg.done::after { content: ""; position: absolute; top: 4px; right: 4px; width: 6px; height: 6px; border-radius: 50%; background: var(--ok); }
+.now { color: var(--muted); font-size: 12px; display: flex; justify-content: space-between; gap: 8px; }
